#!/usr/bin/env python3
"""Scaffold a new Precursor app repo from templates/app.

    bin/new-app mines "Mines"                 # creates ./precursor-mines/
    bin/new-app mines "Mines" --dir ~/Dev/precursor
    bin/new-app mines "Mines" --check         # also integrate into xous-core and build it

The generated app registers with the correct GAM name, uses the real key codes,
stops its pump in the background, persists via precursor-appkit, and ships a
manifest-fragment.json that bin/integrate merges into apps/manifest.json.
"""
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

TOOLKIT = Path(__file__).resolve().parent.parent
TEMPLATE = TOOLKIT / "templates" / "app"
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{1,30}$")

# Package names that collide with crates already in the xous-core workspace
# dependency graph; `cargo -p <name>` becomes ambiguous.
RESERVED = {
    "cipher", "regex", "json", "log", "time", "rand", "sha2", "aes", "hex", "serde",
    "base64", "chrono", "crc", "der", "digest", "rkyv", "spin", "nom", "bitflags",
    "hello", "ball", "vault", "repl", "shellchat", "status", "gam", "pddb", "trng",
}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name", help="Cargo package name: lowercase, digits, '-' (e.g. mines, json-explorer)")
    ap.add_argument("display", help='Name shown in the app menu, e.g. "Mines"')
    ap.add_argument("--dir", default=".", help="parent directory for the new repo (default: cwd)")
    ap.add_argument("--repo-prefix", default="precursor-", help="repo directory prefix")
    ap.add_argument("--check", action="store_true", help="run bin/integrate --check on the new app")
    ap.add_argument("--xous-root", help="xous-core checkout for --check (default: $XOUS_ROOT)")
    a = ap.parse_args()

    if not NAME_RE.match(a.name):
        sys.exit(f"error: {a.name!r} is not a valid app name (lowercase letters, digits, '-'; 2-31 chars)")
    if a.name in RESERVED:
        sys.exit(f"error: {a.name!r} collides with an existing crate in xous-core; pick e.g. {a.name}-app")
    if not a.display.strip() or len(a.display) > 40 or any(c in a.display for c in '"\\\n'):
        sys.exit("error: display name must be 1-40 characters with no quotes, backslashes or newlines")

    dest = Path(a.dir).expanduser().resolve() / f"{a.repo_prefix}{a.name}"
    if dest.exists():
        sys.exit(f"error: {dest} already exists")

    subs = {
        "{{name}}": a.name,
        "{{display}}": a.display,
        "{{NAME_CONST}}": a.name.upper().replace("-", "_"),
    }
    for src in TEMPLATE.rglob("*"):
        if src.is_dir():
            continue
        out = dest / src.relative_to(TEMPLATE)
        out.parent.mkdir(parents=True, exist_ok=True)
        text = src.read_text()
        for k, v in subs.items():
            text = text.replace(k, v)
        out.write_text(text)

    # manifest fragment must still be valid JSON after substitution
    json.loads((dest / "manifest-fragment.json").read_text())

    (dest / ".gitignore").write_text("target/\n")
    (dest / "README.md").write_text(
        f"# {a.display}\n\nA Precursor app. Generated by xous-dev-toolkit `bin/new-app`.\n\n"
        "## Build\n\n```bash\n"
        f"xous-dev-toolkit/bin/integrate --xous-root ~/xous-core --check {dest.name}\n"
        f"cd ~/xous-core && cargo xtask run {a.name}     # hosted mode\n"
        "```\n\n## Keys\n\n| Key | Action |\n|---|---|\n"
        "| ↑ ↓ | Move |\n| Enter | Select |\n| F1 | Reset |\n| Backspace / F4 | Back |\n"
    )
    subprocess.run(["git", "init", "-q", str(dest)], check=False)
    print(f"created {dest}")

    if a.check:
        cmd = [str(TOOLKIT / "bin" / "integrate"), "--check", str(dest)]
        if a.xous_root:
            cmd[1:1] = ["--xous-root", a.xous_root]
        return subprocess.call(cmd)
    print(f"next: bin/integrate --check {dest}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
