#!/usr/bin/env python3
"""Render `bin/integrate --json` output as a markdown status table.

    bin/integrate --check --json status.json ~/Dev/precursor/precursor-*
    bin/status status.json                         # print table
    bin/status status.json --update ecosystem/TRACKER.md   # replace the generated block

The block between `<!-- status:begin -->` and `<!-- status:end -->` in the target
file is replaced; everything else is left alone. Status is "builds" only when
the hosted check passed — nothing is marked shipped by hand.
"""
import argparse
import json
import sys
from datetime import date
from pathlib import Path

BEGIN, END = "<!-- status:begin -->", "<!-- status:end -->"


def render(data: dict) -> str:
    res = data["results"]
    ok = sum(1 for r in res.values() if r["ok"])
    lines = [
        BEGIN,
        f"_Generated by `bin/status` on {date.today().isoformat()} from a hosted check at xous-core "
        f"`{data.get('xous_core') or '?'}` (anchor `{data.get('anchor', '?')}`). "
        f"**{ok}/{len(res)} build.**_",
        "",
        "| App | Hosted build | Errors | Warnings | First error |",
        "|---|---|---:|---:|---|",
    ]
    for pkg in sorted(res, key=lambda p: (res[p]["ok"], p)):
        r = res[pkg]
        first = (r["first_errors"][0] if r["first_errors"] else "").split(": ", 2)[-1]
        first = first.replace("|", "\\|")[:110]
        state = "✅ builds" if r["ok"] else "❌ fails"
        lines.append(f"| {pkg} | {state} | {r['errors']} | {r['warnings']} | {first} |")
    if data.get("warnings"):
        lines += ["", "Packaging warnings:", ""] + [f"- {w}" for w in data["warnings"]]
    lines.append(END)
    return "\n".join(lines) + "\n"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("json_file")
    ap.add_argument("--update", metavar="MD", help="replace the generated block in this markdown file")
    a = ap.parse_args()
    block = render(json.loads(Path(a.json_file).read_text()))
    if not a.update:
        sys.stdout.write(block)
        return 0
    p = Path(a.update)
    text = p.read_text() if p.exists() else ""
    if BEGIN in text and END in text:
        head, rest = text.split(BEGIN, 1)
        tail = rest.split(END, 1)[1].lstrip("\n")
        text = head + block + tail
    else:
        text = text.rstrip() + "\n\n## Build status\n\n" + block
    p.write_text(text)
    print(f"updated {p}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
